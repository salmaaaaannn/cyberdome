# CyberDome Backend Environment Configuration
ENVIRONMENT=development
SECRET_KEY=cyberdome-super-secret-jwt-signing-key-2026-production-ready
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Local SQLite (Default for testing & local development)
DATABASE_URL=sqlite+aiosqlite:///./cyberdome.db

