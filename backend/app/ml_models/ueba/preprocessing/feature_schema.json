    "file_access_count",
    "unique_files_count",
    "sensitive_file_count",
    "file_write_count",
    "file_delete_count",
    "unusual_file_rate",
    "http_request_count",
    "unique_domains_count",
    "external_domain_count",
    "suspicious_domain_count",
    "data_transfer_bytes",
    "email_count",
    "external_recipient_count",
    "attachment_count",
