{
  "module": "url_phishing_detection",
  "version": "url-phishing-v1",
  "dataset_benchmark": "PhishTank_OpenPhish_Benchmark",
  "feature_count": 27,
  "features": [
    "url_length",
    "hostname_length",
    "path_length",
    "query_length",
    "fragment_length",
    "number_of_dots",
    "number_of_hyphens",
    "number_of_underscores",
    "number_of_slashes",
    "number_of_question_marks",
    "number_of_equals",
    "number_of_ampersands",
    "number_of_percent_encoded_chars",
    "number_of_digits",
    "digit_ratio",
    "special_character_count",
    "subdomain_count",
    "hostname_entropy",
    "path_entropy",
    "query_entropy",
    "ip_address_hostname",
    "punycode_indicator",
    "suspicious_tld_indicator",
    "https_indicator",
    "port_present",
    "unusual_port_indicator",
    "url_shortener_indicator"
  ]
}